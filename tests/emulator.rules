rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (collection != 'products' || resource == null ||
         !('rejectStockWrite' in resource.data) || !resource.data.rejectStockWrite);
    }
  }
}
